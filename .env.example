APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=sqlite:///./reclaim.db
COOKIE_SECURE=false
# Production: DATABASE_URL=postgresql+psycopg://user:password@host:5432/reclaim
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email delivery (recommended for production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=
